{
  "name": "CloudScale Commerce API",
  "version": "1.0.0",
  "type": "collection",
  "items": [
    {
      "name": "Authentication",
      "items": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "url": "http://localhost:8001/api/v1/auth/register",
            "headers": [
              { "name": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "json",
              "json": "{\n  \"email\": \"user@cloudscale.io\",\n  \"password\": \"StrongPassword123!\",\n  \"full_name\": \"CloudScale Developer\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "http://localhost:8001/api/v1/auth/login",
            "headers": [
              { "name": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "json",
              "json": "{\n  \"email\": \"user@cloudscale.io\",\n  \"password\": \"StrongPassword123!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "items": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "url": "http://localhost:8002/api/v1/products?page=1&size=10"
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:8002/api/v1/products/3d1d122b-a94b-47cd-899a-aeaae0056325"
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "items": [
        {
          "name": "Get Inventory Levels",
          "request": {
            "method": "GET",
            "url": "http://localhost:8003/api/v1/inventory"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "items": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "url": "http://localhost:8004/api/v1/orders",
            "headers": [
              { "name": "Content-Type", "value": "application/json" },
              { "name": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "json",
              "json": "{\n  \"items\": [\n    {\n      \"product_id\": \"3d1d122b-a94b-47cd-899a-aeaae0056325\",\n      \"quantity\": 2\n    }\n  ]\n}"
            }
          }
        }
      ]
    }
  ]
}
